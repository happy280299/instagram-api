generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION // được @nhắc tên trong caption / comment
  REPLY // có người trả lời comment của mình
  COMMENT_LIKE // có người thích comment của mình
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  username           String    @unique
  password           String
  name               String
  // name đã chuẩn hoá cho tìm kiếm (toSearchText): 'Nguyễn Văn A' -> 'nguyen van a'
  nameSearch         String    @default("")
  avatarUrl          String    @default("")
  bio                String    @default("")
  isVerified         Boolean   @default(false)
  // Trạng thái hoạt động (chat): lần cuối còn mở app; tắt showActivityStatus thì 2 bên không thấy của nhau
  lastActiveAt       DateTime?
  showActivityStatus Boolean   @default(true)
  role               Role      @default(USER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  posts      Post[]
  likes      Like[]
  comments   Comment[]
  savedPosts SavedPost[]
  followers  Follow[]    @relation("following")
  following  Follow[]    @relation("follower")
  stories    Story[]
  storyViews StoryView[]

  notifications     Notification[] @relation("notificationRecipient")
  notificationsSent Notification[] @relation("notificationActor")

  conversations ConversationMember[]
  messages      Message[]
  reelViews     ReelView[]
  commentLikes  CommentLike[]
  refreshTokens RefreshToken[]

  // Tìm user (GET /users/search): ILIKE '%...%' + similarity() dùng index trigram (pg_trgm)
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_username_trgm_idx")
  @@index([nameSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_nameSearch_trgm_idx")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String    @unique
  description   String    @default("")
  price         Int
  originalPrice Int?
  stock         Int       @default(0)
  sold          Int       @default(0)
  imageUrl      String    @default("")
  categoryId    Int
  category      Category  @relation(fields: [categoryId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([categoryId])
  @@index([deletedAt])
}

model Post {
  id          Int       @id @default(autoincrement())
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption     String    @default("")
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  // Bài có đúng 1 video = Reel (giống Instagram), BE tự gắn lúc tạo
  isReel      Boolean   @default(false)
  // Reel: có hiện ở feed + lưới bài chính trên profile không (tab Reels thì luôn có)
  shareToFeed Boolean   @default(true)

  media    PostMedia[]
  likes    Like[]
  comments Comment[]
  savedBy  SavedPost[]

  notifications Notification[]
  reelViews     ReelView[]
  hashtags      PostHashtag[]

  @@index([authorId, createdAt])
  // tab Reels + tab Reels trên profile
  @@index([isReel, createdAt])
  @@index([createdAt])
}

model PostMedia {
  id     Int       @id @default(autoincrement())
  postId Int
  post   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  url    String
  type   MediaType @default(IMAGE)
  width  Int?
  height Int?
  order  Int       @default(0)

  @@index([postId, order])
}

model Like {
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId, createdAt])
}

model Comment {
  id        Int       @id @default(autoincrement())
  postId    Int
  authorId  Int
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Trả lời: chỉ 1 cấp (trả lời 1 câu trả lời thì vẫn gắn vào comment gốc, giống Instagram)
  parentId  Int?
  parent    Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("replies")
  content   String
  createdAt DateTime  @default(now())

  notifications Notification[]
  likes         CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model SavedPost {
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  // Danh sách bài đã lưu của 1 user, lưu gần đây nhất trước
  @@index([userId, createdAt])
}

model Follow {
  followerId  Int
  followingId Int
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  // Danh sách followers / following, mới follow gần đây nhất trước
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

// Story tự hết hạn sau 24h (expiresAt), không cần cron xoá
model Story {
  id        Int       @id @default(autoincrement())
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrl  String
  type      MediaType @default(IMAGE)
  // thời lượng hiển thị (ms), video thì lấy theo độ dài video
  duration  Int       @default(5000)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  views StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  storyId   Int
  viewerId  Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([storyId, viewerId])
  @@index([viewerId])
}

// Mỗi hành động (like / comment / follow) = 1 dòng; gộp "A và 12 người khác" lúc đọc.
// Xoá post / comment / user thì thông báo liên quan tự mất (Cascade)
model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  recipient   User             @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     Int
  actor       User             @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        NotificationType
  postId      Int?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   Int?
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  readAt      DateTime? // null = chưa đọc

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  // tìm để xoá khi bỏ like / bỏ follow
  @@index([actorId, type])
  @@index([postId])
  @@index([commentId])
  // job dọn thông báo cũ
  @@index([createdAt])
}

// Chat (Direct). Hiện mới có chat 1-1; thành viên để ở bảng riêng để sau này mở rộng sang group
model Conversation {
  id            Int       @id @default(autoincrement())
  // Chat 1-1: "<userId nhỏ>:<userId lớn>" -> mỗi cặp chỉ có 1 cuộc trò chuyện. Group: null
  directKey     String?   @unique
  createdAt     DateTime  @default(now())
  // Tin nhắn mới nhất (để sắp xếp hộp thư + hiện preview), null = chưa nhắn gì
  lastMessageAt DateTime?
  lastMessageId Int?

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId    Int
  userId            Int
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt          DateTime     @default(now())
  // Đã đọc tới tin nhắn nào: tính số chưa đọc + hiện "Đã xem" cho người kia
  lastReadMessageId Int?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @default("")
  // Ảnh / video gửi kèm (URL do POST /uploads trả về)
  mediaUrl       String?
  mediaType      MediaType?
  mediaWidth     Int?
  mediaHeight    Int?
  createdAt      DateTime     @default(now())
  // Thu hồi tin nhắn: ẩn với mọi người
  deletedAt      DateTime?

  // Tải tin nhắn theo trang (id giảm dần) trong 1 cuộc trò chuyện
  @@index([conversationId, id])
  @@index([senderId])
}

// 1 người xem 1 reel (đủ ~3s) = 1 lượt xem; còn dùng để không gợi ý lại reel đã xem
model ReelView {
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

// #hashtag trong caption, tách ra lúc tạo / sửa bài
model Hashtag {
  id        Int      @id @default(autoincrement())
  // chữ thường, không có '#': 'đàlạt', 'saigon'
  name      String   @unique
  createdAt DateTime @default(now())

  posts PostHashtag[]

  // gợi ý khi gõ '#...'
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Hashtag_name_trgm_idx")
}

model PostHashtag {
  postId    Int
  hashtagId Int
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  // trang hashtag: bài mới nhất trước
  @@index([hashtagId, postId])
}

model CommentLike {
  userId    Int
  commentId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

// Phiên đăng nhập. Chỉ lưu SHA-256 của refresh token (lộ DB cũng không dùng được token).
// Mỗi lần refresh: thu hồi token cũ, cấp token mới cùng `family` (rotation).
// Token đã thu hồi mà bị dùng lại -> nghi bị đánh cắp -> thu hồi cả family
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  // 1 lần đăng nhập trên 1 thiết bị = 1 family
  family    String
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}
