# Copy thành .env (local) hoặc khai báo trên trang host (Render / Railway...). Không commit .env thật

# Postgres. Neon: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://shop:password@localhost:5432/shop

# Chuỗi ngẫu nhiên dài, MỖI MÔI TRƯỜNG MỘT CHUỖI KHÁC NHAU (vd. openssl rand -base64 48)
JWT_SECRET=change-me
# Hạn accessToken (mặc định 15m). Để dài hơn (vd. 7d) chỉ khi FE chưa gọi POST /auth/refresh
JWT_ACCESS_EXPIRES_IN=15m
# Hạn refreshToken, tính bằng ngày (mặc định 30)
JWT_REFRESH_EXPIRES_DAYS=30

# URL công khai để tạo link file /static/... (ảnh sản phẩm, ảnh upload khi không dùng Cloudinary)
# Local: domain đang phục vụ /static; production: domain của chính BE, vd. https://instaclone-api.onrender.com
APP_URL=http://localhost:3001

# Domain FE được gọi API + kết nối socket, cách nhau bởi dấu phẩy; '*' khớp 1 đoạn bất kỳ.
# Bỏ trống khi chạy local (tự cho phép localhost:3001, localhost:5173)
# FRONTEND_URLS=https://instaclone.netlify.app,https://*--instaclone.netlify.app

# Đặt 1 khi chạy sau proxy (Render, Railway, nginx) để rate limit lấy đúng IP người dùng
# TRUST_PROXY=1

# Cloudinary (thiếu 1 trong 3 biến thì ảnh lưu vào public/uploads, video không upload được)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cổng (Render / Railway tự đặt)
# PORT=3000
